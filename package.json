{
  "name": "brindle",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Platform-agnostic merge-risk classifier and CI extensions",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:core": "npm run typecheck",
    "build:github-action": "ncc build extensions/github-action/index.ts -o extensions/github-action/dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@octokit/request": "^9.2.4",
    "@actions/core": "^1.11.1",
    "@eslint/js": "^9.17.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "@vercel/ncc": "^0.38.3",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.17.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "vitest related --run"
    ]
  },
  "dependencies": {
    "@octokit/graphql": "^8.1.1",
    "@octokit/rest": "^21.0.2",
    "ajv": "^8.17.1",
    "js-yaml": "^4.1.0"
  }
}
