{
  "name": "brindle",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "description": "Platform-agnostic merge-risk classifier and CI extensions",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:core": "npm run typecheck",
    "build:github-action": "ncc build extensions/github-action/index.ts -o extensions/github-action/dist",
    "build:merge-risk-core": "npm run build -w @usebrindle/merge-risk-core",
    "smoke:merge-risk-core-tarball": "node scripts/smoke-merge-risk-core-tarball.mjs",
    "tag:merge-risk-core": "node scripts/tag-merge-risk-core.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@actions/core": "^3.0.1",
    "@eslint/js": "^9.17.0",
    "@octokit/request": "^10.0.10",
    "@types/js-yaml": "^4.0.9",
    "@types/micromatch": "^4.0.9",
    "@types/node": "^24.0.0",
    "@vercel/ncc": "^0.38.3",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "^9.17.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.2.6"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "vitest related --run"
    ]
  },
  "dependencies": {
    "@octokit/graphql": "^9.0.3",
    "@octokit/rest": "^22.0.1",
    "ajv": "^8.20.0",
    "js-yaml": "^4.2.0",
    "micromatch": "^4.0.8"
  }
}
